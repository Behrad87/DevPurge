<ui:FluentWindow x:Class="DevPurge.App.Views.RuleManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DevPurge.App.ViewModels"
        Title="Purge Rules &amp; Targets"
        Height="700" Width="760"
        MinHeight="540" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="#D60B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <ui:TitleBar Grid.Row="0" Title="DevPurge — Ecosystem &amp; Purge Rule Manager" ShowMaximize="False" Icon="pack://application:,,,/Assets/icon.png" />

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="20,4,20,10">
            <Grid.RowDefinitions>
                <!-- Header & Stats -->
                <RowDefinition Height="Auto" />
                <!-- Rules List -->
                <RowDefinition Height="*" />
                <!-- Add Custom Rule Card -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header & Stats Strip -->
            <Border Grid.Row="0" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="#38BDF8" Margin="0,0,8,0" />
                            <TextBlock Text="Disposable Folder Rules" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                        </StackPanel>
                        <TextBlock Text="Toggle built-in frameworks or define custom directories to target during scans."
                                   FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Scrollable Rules List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#A60F172A" BorderBrush="#243044" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Checkbox toggle -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Rule Information -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Delete action for custom rules -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Enable / Disable Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />

                                            <!-- Category Badge -->
                                            <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryName}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding BadgeForeground}" />
                                            </Border>

                                            <!-- Built-in vs Custom Badge -->
                                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                    CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IsBuiltIn, Converter={x:Null}, FallbackValue='Built-in'}"
                                                           FontSize="9" Foreground="#94A3B8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Built-in" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                                                    <Setter Property="Text" Value="Custom" />
                                                                    <Setter Property="Foreground" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Target Folder Names -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                            <TextBlock Text="Targets:" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FolderNamesDisplay}" FontFamily="Consolas, Segoe UI" FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Delete Button (Only active for custom rules) -->
                                    <ui:Button Grid.Column="2" Appearance="Danger" Padding="8,4" VerticalAlignment="Center"
                                               Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                               ToolTip="Delete this custom rule">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,4,0" />
                                            <TextBlock Text="Remove" FontSize="11" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. Add Custom Rule Form Card -->
            <Border Grid.Row="2" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="10" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Symbol="AddCircle24" FontSize="16" Foreground="#10B981" Margin="0,0,6,0" />
                        <TextBlock Text="Add Custom Purge Rule" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC" />
                    </StackPanel>

                    <!-- Input Fields -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Rule Name -->
                        <ui:TextBox Grid.Column="0" Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Rule Name (e.g. My Coverage)" Margin="0,0,6,0" Height="32" FontSize="11" />

                        <!-- Category -->
                        <ui:TextBox Grid.Column="1" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Category (e.g. Testing)" Margin="0,0,6,0" Height="32" FontSize="11" />

                        <!-- Target Folders -->
                        <ui:TextBox Grid.Column="2" Text="{Binding NewFolderNames, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Folders (e.g. coverage, .nyc_output)" Height="32" FontSize="11" />
                    </Grid>

                    <!-- Description & Add Button -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Optional description..." Margin="0,0,8,0" Height="32" FontSize="11" />

                        <ui:Button Grid.Column="1" Command="{Binding AddCustomRuleCommand}" Appearance="Primary" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Add Rule" FontWeight="SemiBold" FontSize="11" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Validation Error Message Banner -->
                    <Border Grid.Row="3" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1"
                            CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                            Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Foreground="#EF4444" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ValidationErrorMessage}" Foreground="#FCA5A5" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" Command="{Binding ResetToDefaultsCommand}" Appearance="Transparent" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Reset to Defaults" FontSize="11" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Grid.Column="2" Click="OnCloseClicked" Appearance="Secondary" Height="32" Padding="20,0">
                    <TextBlock Text="Done" FontWeight="SemiBold" FontSize="12" />
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
