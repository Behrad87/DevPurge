<ui:FluentWindow x:Class="DevPurge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DevPurge.App.ViewModels"
        mc:Ignorable="d"
        Title="DevPurge - Developer Disk Reclaimer"
        Height="780" Width="1180"
        MinHeight="580" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glow Shadow Effect -->
        <DropShadowEffect x:Key="CardGlowEffect" BlurRadius="16" ShadowDepth="0" Color="#0EA5E9" Opacity="0.12" />
        <DropShadowEffect x:Key="FloatingBarGlow" BlurRadius="20" ShadowDepth="2" Color="#000000" Opacity="0.45" />

        <!-- Segmented Button Style -->
        <Style x:Key="PillTabButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3748" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Translucent Fluent Mica Container -->
    <Grid Background="#D60B1120">
        <Grid.RowDefinitions>
            <!-- Native Integrated TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- App Main Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP INTEGRATED TITLEBAR -->
        <ui:TitleBar Grid.Row="0" Title="DevPurge — Developer Disk Reclaimer" Icon="pack://application:,,,/Assets/icon.png">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Quick GitHub Star -->
                    <ui:Button Appearance="Transparent"
                               Command="{Binding OpenGitHubCommand}"
                               ToolTip="Star DevPurge on GitHub"
                               Padding="6,2" Margin="0,0,4,0" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="#FFD700" Margin="0,0,4,0" />
                            <TextBlock Text="Star" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Support Button with 3D Heart -->
                    <ui:Button x:Name="SupportButton"
                               Appearance="Transparent"
                               ToolTip="Support DevPurge Development"
                               Click="OnSupportButtonClicked"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Padding="0" Width="36" Height="28"
                               CornerRadius="4" BorderThickness="0"
                               VerticalAlignment="Center">
                        <Grid Width="16" Height="16" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="1.25" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.15" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:1.80" Value="1.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="1.25" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.15" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:1.80" Value="1.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <!-- 3D Heart Depth Shadow -->
                            <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                                  Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Fill>
                                    <RadialGradientBrush Center="0.32,0.26" GradientOrigin="0.28,0.2" RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="#FF6E8D" Offset="0.0" />
                                        <GradientStop Color="#FF1744" Offset="0.28" />
                                        <GradientStop Color="#C5002C" Offset="0.65" />
                                        <GradientStop Color="#5A0014" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="💖 Sponsor on GitHub (Wall of Fame)" Command="{Binding OpenSponsorsCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Heart24" Foreground="#FF5E7E" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="☕ Ko-fi (Buy Me a Coffee - $3)" Command="{Binding OpenKofiCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DrinkCoffee24" Foreground="#FFA500" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="🇮🇷 ری‌میت - پرداخت ریالی شتاب" Command="{Binding OpenReymitCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Money24" Foreground="#10B981" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="⭐ Star on GitHub" Command="{Binding OpenGitHubCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Star24" Foreground="#FFD700" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- MAIN APP CONTENT AREA -->
        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <!-- Header & Workspace Bar -->
                <RowDefinition Height="Auto" />
                <!-- KPI Analytics Metric Cards -->
                <RowDefinition Height="Auto" />
                <!-- Filters & Controls Bar -->
                <RowDefinition Height="Auto" />
                <!-- Main Data Content / States -->
                <RowDefinition Height="*" />
                <!-- Pinned / Floating Purge Action Bar -->
                <RowDefinition Height="Auto" />
                <!-- Status Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. HEADER & WORKSPACE SELECTOR CARD -->
            <Border Grid.Row="0" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Subrow: App Identity & Quick Path Presets -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Title & Tag -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0" ClipToBounds="True">
                                <Image Source="pack://application:,,,/Assets/icon.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="DevPurge" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.1 • Developer Edition" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Border>
                            <TextBlock Text="— Fast developer disk reclaimer for node_modules, bin/obj, target, &amp; virtualenvs"
                                       FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>

                        <!-- Quick Path Presets -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Quick presets:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="C:\repos"
                                       Appearance="Transparent" Padding="6,2" Margin="0,0,4,0" ToolTip="Quick scan C:\repos">
                                <TextBlock Text="📁 C:\repos" FontSize="11" Foreground="#38BDF8" />
                            </ui:Button>
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="D:\repos"
                                       Appearance="Transparent" Padding="6,2" ToolTip="Quick scan D:\repos">
                                <TextBlock Text="📁 D:\repos" FontSize="11" Foreground="#38BDF8" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Subrow: Workspace Directory Input & Primary Scan Button -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Select or enter developer workspace directory (e.g. C:\repos or D:\repos)..."
                                    VerticalContentAlignment="Center" Margin="0,0,8,0" Height="38" />

                        <ui:Button Grid.Column="1" Command="{Binding BrowsePathCommand}"
                                   Appearance="Secondary" Height="38" Margin="0,0,8,0" ToolTip="Browse workspace folder">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                <TextBlock Text="Browse..." FontWeight="Medium" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Grid.Column="2" Command="{Binding ScanCommand}"
                                   Appearance="Primary" Height="38" Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0" />
                                <TextBlock Text="Scan Workspace" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Cancel Scan Button (Revealed during active scan) -->
                        <ui:Button Grid.Column="3" Command="{Binding CancelScanCommand}"
                                   Appearance="Danger" Height="38" Margin="8,0,0,0" Padding="12,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                                <TextBlock Text="Cancel" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. KPI ANALYTICS METRIC CARDS STRIP -->
            <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric Card 1: Total Reclaimable Space -->
                <Border Grid.Column="0" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="RECLAIMABLE SPACE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Text="{Binding FormattedTotalDiscoveredSize}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DiscoveredCount, StringFormat='{}{0} disposable folders found'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#162E44" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Metric Card 2: Selected for Purge -->
                <Border Grid.Column="1" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="6,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="QUEUED FOR PURGE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Text="{Binding FormattedSelectedSize}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} folders selected'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#064E3B" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Metric Card 3: Stale Abandoned Caches (>30 days) -->
                <Border Grid.Column="2" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="6,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STALE CACHES (>30D)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <TextBlock Text="{Binding FormattedStaleSize}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding StaleCount, StringFormat='{}{0} untouched folders'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#451A03" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="History24" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Metric Card 4: Safety Shield Mode -->
                <Border Grid.Column="3" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SAFETY SHIELD" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                            <CheckBox IsChecked="{Binding SendToRecycleBin}" Content="Recycle Bin Safe Mode"
                                      FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"
                                      ToolTip="When enabled, deleted folders are moved to Windows Recycle Bin for safe recovery" />
                            <TextBlock Text="Zero risk of permanent loss" FontSize="10" Foreground="#10B981" Margin="22,1,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2E1A47" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. CONTROLS & FILTERING TOOLBAR -->
            <Border Grid.Row="2" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Ecosystem Category Pills -->
                        <RowDefinition Height="Auto" />
                        <!-- Filter Controls & Actions -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ecosystem / Tech Stack Filter Chips -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CategoryPillButton}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Filters & Search Toolbar -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Age Filter Segmented Buttons + Search Box -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Age Segmented Group -->
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PillTabButton}" Content="All Time"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="0" />
                                    <Button Style="{StaticResource PillTabButton}" Content="> 7d"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="1" />
                                    <Button Style="{StaticResource PillTabButton}" Content="> 14d"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="2" />
                                    <Button Style="{StaticResource PillTabButton}" Content="> 30d"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="3" />
                                </StackPanel>
                            </Border>

                            <!-- Live Instant Search -->
                            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Filter folders, projects, or stacks..."
                                        Width="220" VerticalContentAlignment="Center"
                                        ClearButtonEnabled="True" Height="30" />
                        </StackPanel>

                        <!-- Right: Quick Batch Selection -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding SelectAllCommand}" Appearance="Transparent" Padding="8,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,0,4,0" />
                                    <TextBlock Text="Select All" FontSize="11" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Command="{Binding DeselectAllCommand}" Appearance="Transparent" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="Deselect" FontSize="11" />
                            </ui:Button>

                            <ui:Button Command="{Binding SelectStaleCommand}" Appearance="Transparent" Padding="8,4"
                                       ToolTip="Quickly select only abandoned folders older than 30 days">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="#F59E0B" Margin="0,0,4,0" />
                                    <TextBlock Text="Select Stale (>30d)" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. MAIN DATA CONTENT / STATES -->
            <Grid Grid.Row="3">
                <!-- Scanning Progress Bar -->
                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

                <!-- Results DataGrid -->
                <DataGrid ItemsSource="{Binding DisplayedItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="42"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          Background="#99111827"
                          BorderBrush="#243044" BorderThickness="1">
                    <DataGrid.Columns>
                        <!-- Checkbox Column -->
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="40" Header="" />

                        <!-- Category Badge Column -->
                        <DataGridTemplateColumn Header="Ecosystem" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CategoryBadgeBackground}"
                                            BorderBrush="{Binding CategoryBadgeBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{Binding CategoryBadgeForeground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Folder Path & Repository Column -->
                        <DataGridTemplateColumn Header="Folder &amp; Repository" Width="*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Project / Repo Badge -->
                                        <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ParentDirectoryName, StringFormat='[{0}]'}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </Border>
                                        <!-- Folder Name -->
                                        <TextBlock Text="{Binding FolderName}" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <!-- Full Path Details -->
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Age / Last Modified Column -->
                        <DataGridTemplateColumn Header="Age" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AgeBadgeBackground}"
                                            BorderBrush="{Binding AgeBadgeBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedAge}" FontSize="11"
                                                   Foreground="{Binding AgeBadgeForeground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Size Column -->
                        <DataGridTemplateColumn Header="Size" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="13"
                                               Foreground="{Binding SizeForeground}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quick Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Open in Explorer -->
                                        <ui:Button Command="{Binding OpenInExplorerCommand}"
                                                   Appearance="Transparent" Padding="4" Margin="0,0,4,0"
                                                   ToolTip="Open in File Explorer">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="#94A3B8" />
                                        </ui:Button>
                                        <!-- Copy Path -->
                                        <ui:Button Command="{Binding CopyPathCommand}"
                                                   Appearance="Transparent" Padding="4"
                                                   ToolTip="Copy path to clipboard">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="#94A3B8" />
                                        </ui:Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- EMPTY / WELCOME STATE -->
                <Border Background="#CC0F172A" CornerRadius="10" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#243044" BorderThickness="1"
                        Visibility="{Binding HasNoItemsAndNotScanning, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center">
                        <Border Background="#162E44" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="FolderSearch24" FontSize="32" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Ready to Reclaim Developer SSD Space"
                                   FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        <TextBlock Text="DevPurge scans workspaces in seconds to batch-purge abandoned node_modules, bin/obj, target, and virtualenvs without ever touching source code or Git repositories."
                                   FontSize="12" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,20" />
                        
                        <!-- Quick Start Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="C:\repos"
                                       Appearance="Secondary" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                    <TextBlock Text="Scan C:\repos" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="D:\repos"
                                       Appearance="Secondary" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                    <TextBlock Text="Scan D:\repos" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Command="{Binding BrowsePathCommand}" Appearance="Transparent">
                                <TextBlock Text="Choose Folder..." />
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SCANNING OVERLAY STATE -->
                <Border Background="#E60F172A" CornerRadius="10" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#38BDF8" BorderThickness="1"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center" />
                        <TextBlock Text="Scanning Workspace..." FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentScanningPath}" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,12" MaxWidth="380" />
                        <ui:Button Command="{Binding CancelScanCommand}" Appearance="Secondary" HorizontalAlignment="Center" Padding="14,4">
                            <TextBlock Text="Cancel Scan" FontSize="11" />
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. DOCKED / FLOATING PURGE ACTION BAR -->
            <Border Grid.Row="4" Background="#E6111827" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="10" Padding="16,10" Margin="0,10,0,0"
                    Effect="{StaticResource FloatingBarGlow}"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Selected Count & Total Reclaimable -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" />
                            <TextBlock Text="🛡️ 100% Safety Guarantee: Git commits, branch history, and source code are never touched"
                                       FontSize="10" Foreground="#10B981" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Middle: Recycle Bin Toggle -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding SendToRecycleBin}"
                              Content="Recycle Bin (Safe Undo)" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Deleted folders can be restored at any time from the Windows Recycle Bin" />

                    <!-- Right: Primary Purge Button -->
                    <ui:Button Grid.Column="2" Command="{Binding PurgeCommand}"
                               Appearance="Danger" Padding="20,10" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0" />
                            <TextBlock Text="Purge Selected" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- 6. FOOTER STATUS BAR -->
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ 100% Offline • Zero Telemetry • Open Source Forever"
                               FontSize="11" Foreground="#64748B" Margin="0,0,16,0" />
                    <TextBlock Text="by Behrad87" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
