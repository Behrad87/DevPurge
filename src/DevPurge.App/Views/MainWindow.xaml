<ui:FluentWindow x:Class="DevPurge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DevPurge.App.ViewModels"
        mc:Ignorable="d"
        Title="DevPurge - Developer Disk Reclaimer"
        Height="780" Width="1180"
        MinHeight="580" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Glow Shadow Effect -->
        <DropShadowEffect x:Key="CardGlowEffect" BlurRadius="16" ShadowDepth="0" Color="#0EA5E9" Opacity="0.12" />
        <DropShadowEffect x:Key="FloatingBarGlow" BlurRadius="24" ShadowDepth="2" Color="#000000" Opacity="0.55" />

        <!-- Segmented Button Style -->
        <Style x:Key="PillTabButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="border" Property="Background" Value="#2538BDF8" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3748" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="📁 Open in File Explorer" Command="{Binding OpenInExplorerCommand}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Folder24" Foreground="#38BDF8" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="📋 Copy Full Path" Command="{Binding CopyPathCommand}">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Copy24" Foreground="#94A3B8" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A334155" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#200EA5E9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewSwitcherCardButton" TargetType="Button" BasedOn="{StaticResource PillTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0B1120" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewSwitcherTableButton" TargetType="Button" BasedOn="{StaticResource PillTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardView}" Value="False">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0B1120" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgeFilter0Button" TargetType="Button" BasedOn="{StaticResource PillTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgeFilter0}" Value="True">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0B1120" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgeFilter1Button" TargetType="Button" BasedOn="{StaticResource PillTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgeFilter1}" Value="True">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0B1120" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgeFilter2Button" TargetType="Button" BasedOn="{StaticResource PillTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgeFilter2}" Value="True">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0B1120" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgeFilter3Button" TargetType="Button" BasedOn="{StaticResource PillTabButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAgeFilter3}" Value="True">
                    <Setter Property="Background" Value="#F59E0B" />
                    <Setter Property="Foreground" Value="#0B1120" />
                    <Setter Property="BorderBrush" Value="#F59E0B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="Esc" Command="{Binding CancelScanCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="D" Command="{Binding DeselectAllCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="I" Command="{Binding InvertSelectionCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="E" Command="{Binding ExportResultsCommand}" />
    </Window.InputBindings>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Translucent Fluent Mica Container -->
    <Grid Background="#D60B1120">
        <Grid.RowDefinitions>
            <!-- Native Integrated TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- App Main Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP INTEGRATED TITLEBAR -->
        <ui:TitleBar Grid.Row="0" Title="DevPurge — Developer Disk Reclaimer" Icon="pack://application:,,,/Assets/icon.png">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <!-- Quick GitHub Star -->
                    <ui:Button Appearance="Transparent"
                               Command="{Binding OpenGitHubCommand}"
                               ToolTip="Star DevPurge on GitHub"
                               Padding="6,2" Margin="0,0,4,0" Height="28">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="#FFD700" Margin="0,0,4,0" />
                            <TextBlock Text="Star" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Support Button with 3D Heart -->
                    <ui:Button x:Name="SupportButton"
                               Appearance="Transparent"
                               ToolTip="Support DevPurge Development"
                               Click="OnSupportButtonClicked"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               Padding="0" Width="36" Height="28"
                               CornerRadius="4" BorderThickness="0"
                               VerticalAlignment="Center">
                        <Grid Width="16" Height="16" RenderTransformOrigin="0.5,0.5" ClipToBounds="False">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="1.25" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.15" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:1.80" Value="1.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="1.0" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.14" Value="1.25" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.28" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="1.15" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.56" Value="1.0" KeySpline="0.2, 0.8, 0.2, 1" />
                                                <SplineDoubleKeyFrame KeyTime="0:0:1.80" Value="1.0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <!-- 3D Heart Depth Shadow -->
                            <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                                  Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.Fill>
                                    <RadialGradientBrush Center="0.32,0.26" GradientOrigin="0.28,0.2" RadiusX="0.75" RadiusY="0.75">
                                        <GradientStop Color="#FF6E8D" Offset="0.0" />
                                        <GradientStop Color="#FF1744" Offset="0.28" />
                                        <GradientStop Color="#C5002C" Offset="0.65" />
                                        <GradientStop Color="#5A0014" Offset="1.0" />
                                    </RadialGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="💖 Sponsor on GitHub (Wall of Fame)" Command="{Binding OpenSponsorsCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Heart24" Foreground="#FF5E7E" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="☕ Ko-fi (Buy Me a Coffee - $3)" Command="{Binding OpenKofiCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DrinkCoffee24" Foreground="#FFA500" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="🇮🇷 ری‌میت - پرداخت ریالی شتاب" Command="{Binding OpenReymitCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Money24" Foreground="#10B981" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="⭐ Star on GitHub" Command="{Binding OpenGitHubCommand}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Star24" Foreground="#FFD700" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- MAIN APP CONTENT AREA -->
        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <!-- 0. Header & Workspace Command Bar -->
                <RowDefinition Height="Auto" />
                <!-- 1. Storage Analytics Ribbon & Proportional Bar -->
                <RowDefinition Height="Auto" />
                <!-- 2. Controls & Filtering Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- 3. Main Data Content / States -->
                <RowDefinition Height="*" />
                <!-- 4. Pinned / Floating Purge Action Bar -->
                <RowDefinition Height="Auto" />
                <!-- 5. Status Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. WORKSPACE COMMAND HEADER CARD -->
            <Border Grid.Row="0" Background="#A60F172A" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Subrow: Brand Identity & Quick Path Presets -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Title & Tag -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="8" Width="28" Height="28" Margin="0,0,8,0" ClipToBounds="True">
                                <Image Source="pack://application:,,,/Assets/icon.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="DevPurge" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0 • Fluent" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Border>
                            <TextBlock Text="— Fast developer disk reclaimer for node_modules, bin/obj, target &amp; virtualenvs"
                                       FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <!-- Quick Path Presets -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Quick presets:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="D:\repos"
                                       Appearance="Transparent" Padding="6,2" Margin="0,0,4,0" ToolTip="Quick scan D:\repos">
                                <TextBlock Text="📁 D:\repos" FontSize="11" Foreground="#38BDF8" />
                            </ui:Button>
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="C:\repos"
                                       Appearance="Transparent" Padding="6,2" ToolTip="Quick scan C:\repos">
                                <TextBlock Text="📁 C:\repos" FontSize="11" Foreground="#38BDF8" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Subrow: Workspace Directory Input & Primary Scan Button -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Select or enter developer workspace directory (e.g. C:\repos or D:\repos)..."
                                    VerticalContentAlignment="Center" Margin="0,0,8,0" Height="36" />

                        <ui:Button Grid.Column="1" Click="OnHistoryButtonClicked"
                                   Appearance="Secondary" Height="36" Margin="0,0,8,0" ToolTip="Recent workspace history">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="History24" Margin="0,0,6,0" Foreground="#38BDF8" />
                                <TextBlock Text="History" FontWeight="Medium" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Grid.Column="2" Command="{Binding BrowsePathCommand}"
                                   Appearance="Secondary" Height="36" Margin="0,0,8,0" ToolTip="Browse workspace folder">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                                <TextBlock Text="Browse..." FontWeight="Medium" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Grid.Column="3" Command="{Binding OpenRuleManagerCommand}"
                                   Appearance="Secondary" Height="36" Margin="0,0,8,0" ToolTip="Configure purge rules and target ecosystems">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" Foreground="#A855F7" />
                                <TextBlock Text="{Binding ActiveRulesSummary}" FontWeight="Medium" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Grid.Column="4" Command="{Binding ScanCommand}"
                                   Appearance="Primary" Height="36" Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" Margin="0,0,8,0" />
                                <TextBlock Text="Scan Workspace" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Cancel Scan Button (Revealed during active scan) -->
                        <ui:Button Grid.Column="5" Command="{Binding CancelScanCommand}"
                                   Appearance="Danger" Height="36" Margin="8,0,0,0" Padding="12,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Dismiss24" Margin="0,0,6,0" />
                                <TextBlock Text="Cancel" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 1. STORAGE ANALYTICS HUD & ECOSYSTEM DISTRIBUTION RIBBON -->
            <Border Grid.Row="1" Background="#A60F172A" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- KPI Strip -->
                        <RowDefinition Height="Auto" />
                        <!-- Storage Distribution Stacked Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- KPI Strip -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1: Total Reclaimable Space -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#162E44" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="HardDrive24" FontSize="18" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL DISCOVERED" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding FormattedTotalDiscoveredSize}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,1,0,0" />
                                <TextBlock FontSize="11" Foreground="#94A3B8">
                                    <Run Text="{Binding DiscoveredCount, Mode=OneWay}" /><Run Text=" folders • " /><Run Text="{Binding TotalDiscoveredFiles, Mode=OneWay, StringFormat='{}{0:N0}'}" /><Run Text=" files" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Metric 2: Queued For Purge -->
                        <Grid Grid.Column="1" Margin="5,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#064E3B" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="QUEUED FOR PURGE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding FormattedSelectedSize}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,1,0,0" />
                                <TextBlock FontSize="11" Foreground="#94A3B8">
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" folders • " /><Run Text="{Binding SelectedFiles, Mode=OneWay, StringFormat='{}{0:N0}'}" /><Run Text=" files" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- Metric 3: Stale Abandoned Caches -->
                        <Grid Grid.Column="2" Margin="5,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#451A03" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="History24" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="STALE CACHES (>30D)" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding FormattedStaleSize}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" Margin="0,1,0,0" />
                                <ui:Button Command="{Binding SelectStaleCommand}" Appearance="Transparent" Padding="0" HorizontalAlignment="Left"
                                           ToolTip="Quickly queue all abandoned folders older than 30 days">
                                    <TextBlock Text="{Binding StaleCount, StringFormat='Select {0} stale'}" FontSize="11" Foreground="#F59E0B" TextDecorations="Underline" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Metric 4: Estimated Storage Value -->
                        <Grid Grid.Column="3" Margin="5,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#2E1A47" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Money24" FontSize="18" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ESTIMATED VALUE" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding FormattedEstimatedSavings}" FontSize="18" FontWeight="Bold" Foreground="#C084FC" Margin="0,1,0,0" />
                                <TextBlock Text="NVMe storage saved" FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Storage Distribution Proportional Bar -->
                    <Border Grid.Row="1" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,8,0,2"
                            SizeChanged="StorageBar_SizeChanged">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="ECOSYSTEM STORAGE DISTRIBUTION" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding FormattedTotalDiscoveredSize, StringFormat='{}{0} Reclaimable'}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Stacked Distribution Bar -->
                            <Border Grid.Row="1" Background="#1E293B" CornerRadius="4" Height="7" Margin="0,0,0,6" ClipToBounds="True">
                                <ItemsControl ItemsSource="{Binding EcosystemSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="{Binding PixelWidth}" Height="7" Background="{Binding DotColor}"
                                                    Margin="0,0,1,0" CornerRadius="2" ToolTip="{Binding ToolTipText}" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Legend Items -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding EcosystemSegments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CategoryPillButton}"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Margin="0,0,6,0" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding DotColor}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayText}" FontSize="10" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. CONTROLS & FILTERING TOOLBAR -->
            <Border Grid.Row="2" Background="#A60F172A" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Ecosystem Category Pills -->
                        <RowDefinition Height="Auto" />
                        <!-- Filter Controls & Actions -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Ecosystem / Tech Stack Filter Chips -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding CategoryFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CategoryPillButton}"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DisplayText}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Filters & Search Toolbar -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Age Filter Segmented Buttons + Search Box -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Age Segmented Group -->
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource AgeFilter0Button}" Content="All Time"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="0" />
                                    <Button Style="{StaticResource AgeFilter1Button}" Content="> 7d"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="1" />
                                    <Button Style="{StaticResource AgeFilter2Button}" Content="> 14d"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="2" />
                                    <Button Style="{StaticResource AgeFilter3Button}" Content="> 30d (Stale)"
                                            Command="{Binding SetMinAgeFilterCommand}" CommandParameter="3" />
                                </StackPanel>
                            </Border>

                            <!-- Live Instant Search -->
                            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Filter folders, projects, or stacks..."
                                        Width="230" VerticalContentAlignment="Center"
                                        ClearButtonEnabled="True" Height="30" />
                        </StackPanel>

                        <!-- Right: Quick Batch Selection -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Command="{Binding SelectAllCommand}" Appearance="Transparent" Padding="8,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,0,4,0" />
                                    <TextBlock Text="Select All" FontSize="11" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Command="{Binding DeselectAllCommand}" Appearance="Transparent" Padding="8,4" Margin="0,0,4,0">
                                <TextBlock Text="Deselect" FontSize="11" />
                            </ui:Button>

                            <ui:Button Command="{Binding InvertSelectionCommand}" Appearance="Transparent" Padding="8,4" Margin="0,0,4,0"
                                       ToolTip="Invert selection across folders (Ctrl+Shift+I)">
                                <TextBlock Text="Invert" FontSize="11" />
                            </ui:Button>

                            <ui:Button Command="{Binding SelectStaleCommand}" Appearance="Transparent" Padding="8,4"
                                       ToolTip="Quickly select only abandoned folders older than 30 days">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="#F59E0B" Margin="0,0,4,0" />
                                    <TextBlock Text="Select Stale (>30d)" FontSize="11" Foreground="#F59E0B" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Vertical Separator -->
                            <Border Width="1" Height="16" Background="#334155" Margin="6,0,6,0" VerticalAlignment="Center" />

                            <!-- View Mode Switcher -->
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ViewSwitcherCardButton}"
                                            Command="{Binding SetViewModeCommand}" CommandParameter="cards"
                                            ToolTip="Repository Project Cards View">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Grid24" FontSize="12" Margin="0,0,4,0" />
                                            <TextBlock Text="Cards" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ViewSwitcherTableButton}"
                                            Command="{Binding SetViewModeCommand}" CommandParameter="table"
                                            ToolTip="Compact Table View">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Table24" FontSize="12" Margin="0,0,4,0" />
                                            <TextBlock Text="Table" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Vertical Separator -->
                            <Border Width="1" Height="16" Background="#334155" Margin="6,0,6,0" VerticalAlignment="Center" />

                            <!-- Export Results Button -->
                            <ui:Button Command="{Binding ExportResultsCommand}" Appearance="Transparent" Padding="8,4"
                                       ToolTip="Export scan results to CSV, JSON, or Markdown (Ctrl+Shift+E)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,4,0" Foreground="#38BDF8" />
                                    <TextBlock Text="Export..." FontSize="11" Foreground="#38BDF8" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. MAIN DATA CONTENT / STATES -->
            <Grid Grid.Row="3">
                <!-- Scanning Progress Bar -->
                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

                <!-- 3A. REPOSITORY CARDS VIEW -->
                <ScrollViewer Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding GroupedRepositories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#A60F172A" BorderBrush="#243044" BorderThickness="1"
                                        CornerRadius="12" Margin="0,0,0,10" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Card Header -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Card Folders Body -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header Row -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <!-- Tech Icon -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Repo Info -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Space & Actions -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tech Badge -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                                    Background="{Binding TechBadgeBackground}"
                                                    BorderBrush="{Binding TechBadgeBorder}" BorderThickness="1"
                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TechAbbreviation}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{Binding TechBadgeForeground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Repo Name & Path -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RepositoryName}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                                                    <!-- Primary Ecosystem Chip -->
                                                    <Border Background="{Binding TechBadgeBackground}" BorderBrush="{Binding TechBadgeBorder}"
                                                            BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PrimaryEcosystem}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding TechBadgeForeground}" />
                                                    </Border>
                                                    <!-- Folder count badge -->
                                                    <TextBlock Text="{Binding FolderCountText}" FontSize="11" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding RepositoryPath}" FontSize="11" Foreground="#64748B" FontFamily="Consolas, Segoe UI"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RepositoryPath}" />
                                            </StackPanel>

                                            <!-- Right: Total Size, Checkbox, Actions, and Expand Toggle -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Total Size -->
                                                <TextBlock Text="{Binding FormattedTotalSize}" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />

                                                <!-- Open in Explorer -->
                                                <ui:Button Command="{Binding OpenInExplorerCommand}" Appearance="Transparent" Padding="4" Margin="0,0,8,0"
                                                           ToolTip="Open repository folder in File Explorer">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="#94A3B8" />
                                                </ui:Button>

                                                <!-- Repo-level CheckBox -->
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                          ToolTip="Select or deselect all disposable folders in this repository" />

                                                <!-- Collapse / Expand Button -->
                                                <ui:Button Command="{Binding ToggleExpandCommand}" Appearance="Transparent" Padding="4"
                                                           ToolTip="Toggle expandable folder list">
                                                    <ui:SymbolIcon Symbol="{Binding ExpandIconSymbol}" FontSize="14" Foreground="#94A3B8" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Folders List Body (Visible when IsExpanded) -->
                                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="0,8,0,0"
                                                BorderBrush="#1E293B" BorderThickness="0,1,0,0"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Folders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#400B1120" BorderBrush="#1E293B" BorderThickness="1"
                                                                CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Folder CheckBox -->
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                          VerticalAlignment="Center" Margin="0,0,10,0" />

                                                                <!-- Folder Monospace Tag & Path -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                                            CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FolderName}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                                                    </Border>
                                                                    <!-- Age badge -->
                                                                    <Border Background="{Binding AgeBadgeBackground}" BorderBrush="{Binding AgeBadgeBorder}"
                                                                            BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FormattedAge}" FontSize="10" Foreground="{Binding AgeBadgeForeground}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                                </StackPanel>

                                                                <!-- Mini visual size bar -->
                                                                <Border Grid.Column="2" Background="#1E293B" Height="4" CornerRadius="2" Width="60"
                                                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                                                    <Border Background="#38BDF8" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                                                            Width="{Binding RelativeSizeWidth}" />
                                                                </Border>

                                                                <!-- Folder Size -->
                                                                <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12"
                                                                           Foreground="{Binding SizeForeground}" VerticalAlignment="Center" Margin="0,0,14,0" MinWidth="70" TextAlignment="Right" />

                                                                <!-- Quick Actions -->
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:Button Command="{Binding OpenInExplorerCommand}" Appearance="Transparent" Padding="4" Margin="0,0,4,0" ToolTip="Open in File Explorer">
                                                                        <ui:SymbolIcon Symbol="Folder24" FontSize="13" Foreground="#94A3B8" />
                                                                    </ui:Button>
                                                                    <ui:Button Command="{Binding CopyPathCommand}" Appearance="Transparent" Padding="4" ToolTip="Copy path to clipboard">
                                                                        <ui:SymbolIcon Symbol="Copy24" FontSize="13" Foreground="#94A3B8" />
                                                                    </ui:Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 3B. COMPACT TABLE VIEW -->
                <DataGrid Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                          ItemsSource="{Binding DisplayedItems}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="42"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          Background="#A60F172A"
                          BorderBrush="#243044" BorderThickness="1">
                    <DataGrid.Columns>
                        <!-- Checkbox Column -->
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                Width="40" Header="" />

                        <!-- Ecosystem Badge Column -->
                        <DataGridTemplateColumn Header="Ecosystem" Width="135" SortMemberPath="CategoryName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CategoryBadgeBackground}"
                                            BorderBrush="{Binding CategoryBadgeBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="{Binding CategoryIconSymbol}" FontSize="12" Foreground="{Binding CategoryBadgeForeground}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{Binding CategoryBadgeForeground}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Folder Path & Repository Column -->
                        <DataGridTemplateColumn Header="Folder &amp; Repository" Width="*" MinWidth="240" SortMemberPath="Path">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Project / Repo Badge -->
                                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ParentDirectoryName, StringFormat='[{0}]'}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </Border>
                                        <!-- Target Folder Monospace Tag -->
                                        <Border Background="#0B1120" BorderBrush="#243044" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FolderName}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" />
                                        </Border>
                                        <!-- Full Path Details -->
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Age / Last Modified Column -->
                        <DataGridTemplateColumn Header="Age" Width="110" SortMemberPath="AgeDays">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AgeBadgeBackground}"
                                            BorderBrush="{Binding AgeBadgeBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedAge}" FontSize="11"
                                                   Foreground="{Binding AgeBadgeForeground}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Size Column with Visual Impact Mini Bar -->
                        <DataGridTemplateColumn Header="Size" Width="135" SortMemberPath="SizeBytes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding FormattedSize}" FontWeight="Bold" FontSize="12"
                                                   Foreground="{Binding SizeForeground}" HorizontalAlignment="Right" />
                                        <Border Grid.Row="1" Background="#1E293B" Height="3" CornerRadius="1.5" Margin="0,3,0,0" Width="80" HorizontalAlignment="Right">
                                            <Border Background="#38BDF8" Height="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Width="{Binding RelativeSizeWidth}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quick Actions Column -->
                        <DataGridTemplateColumn Header="Actions" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Open in Explorer -->
                                        <ui:Button Command="{Binding OpenInExplorerCommand}"
                                                   Appearance="Transparent" Padding="4" Margin="0,0,4,0"
                                                   ToolTip="Open in File Explorer">
                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Foreground="#94A3B8" />
                                        </ui:Button>
                                        <!-- Copy Path -->
                                        <ui:Button Command="{Binding CopyPathCommand}"
                                                   Appearance="Transparent" Padding="4"
                                                   ToolTip="Copy path to clipboard">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="#94A3B8" />
                                        </ui:Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- EMPTY / WELCOME STATE -->
                <Border Background="#CC0F172A" CornerRadius="12" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#243044" BorderThickness="1"
                        Visibility="{Binding HasNoItemsAndNotScanning, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Center">
                        <Border Background="#162E44" Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="FolderSearch24" FontSize="32" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Ready to Reclaim Developer SSD Space"
                                   FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        <TextBlock Text="DevPurge scans workspaces in seconds to batch-purge abandoned node_modules, bin/obj, target, and virtualenvs without ever touching source code or Git repositories."
                                   FontSize="12" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,20" />
                        
                        <!-- Quick Start Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="D:\repos"
                                       Appearance="Secondary" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                    <TextBlock Text="Scan D:\repos" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="C:\repos"
                                       Appearance="Secondary" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                                    <TextBlock Text="Scan C:\repos" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Command="{Binding BrowsePathCommand}" Appearance="Transparent">
                                <TextBlock Text="Choose Folder..." />
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SCANNING OVERLAY STATE -->
                <Border Background="#E60F172A" CornerRadius="12" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#38BDF8" BorderThickness="1"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <StackPanel MaxWidth="440" HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center" />
                        <TextBlock Text="Scanning Workspace..." FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentScanningPath}" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,12" MaxWidth="380" />
                        <ui:Button Command="{Binding CancelScanCommand}" Appearance="Secondary" HorizontalAlignment="Center" Padding="14,4">
                            <TextBlock Text="Cancel Scan" FontSize="11" />
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. FLOATING PURGE ACTION DOCK -->
            <Border Grid.Row="4" Background="#E60F172A" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="14" Padding="16,10" Margin="0,10,0,0"
                    Effect="{StaticResource FloatingBarGlow}"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Selected Count & Total Reclaimable -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#2A141A" BorderBrush="#EF4444" BorderThickness="1" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Delete24" Foreground="#EF4444" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" />
                            <TextBlock Text="🛡️ 100% Safety Guarantee: Git commits, branch history, and source code are never touched"
                                       FontSize="10" Foreground="#10B981" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Middle: Recycle Bin Toggle -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding SendToRecycleBin}"
                              Content="Recycle Bin Safe Mode" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Deleted folders can be restored at any time from the Windows Recycle Bin" />

                    <!-- Right: Primary Purge Button -->
                    <ui:Button Grid.Column="2" Command="{Binding PurgeCommand}"
                               Appearance="Danger" Padding="20,10" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" Margin="0,0,8,0" />
                            <TextBlock Text="Purge Selected" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- 5. FOOTER STATUS BAR -->
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️ 100% Offline • Zero Telemetry • Open Source Forever"
                               FontSize="11" Foreground="#64748B" Margin="0,0,16,0" />
                    <TextBlock Text="by Behrad87" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
