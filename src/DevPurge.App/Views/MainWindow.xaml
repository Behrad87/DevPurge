<ui:FluentWindow x:Class="DevPurge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DevPurge.App.ViewModels"
        mc:Ignorable="d"
        Title="DevPurge - Developer Disk Reclaimer"
        Height="680" Width="1080"
        MinHeight="520" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="#0F172A">
        <Grid.RowDefinitions>
            <!-- Native TitleBar with Minimize, Maximize, Close controls -->
            <RowDefinition Height="Auto" />
            <!-- App Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DevPurge - Developer Disk Reclaimer" Icon="pack://application:,,,/Assets/icon.png" />

        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Toolbar / Controls -->
                <RowDefinition Height="Auto" />
                <!-- Main Content (DataGrid / Empty state) -->
                <RowDefinition Height="*" />
                <!-- Footer Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Branding -->
            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Margin="0,0,12,0" Width="36" Height="36" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="DevPurge" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#2B2D3A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0 • Open Source" FontSize="11" Foreground="#9E9E9E" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Ultra-fast developer disk reclaimer for node_modules, bin/obj, target, and build caches."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="48,4,0,0" />
            </StackPanel>

            <!-- Social & Donation Dropdown -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="SupportButton" Appearance="Primary" Padding="14,7" Click="OnSupportButtonClicked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Heart24" Foreground="#FF5E7E" Margin="0,0,8,0" />
                        <TextBlock Text="Support DevPurge" FontWeight="SemiBold" />
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="11" Margin="8,2,0,0" VerticalAlignment="Center" Foreground="#E2E8F0" />
                    </StackPanel>
                    <ui:Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="💖 Sponsor on GitHub (Wall of Fame)" Command="{Binding OpenSponsorsCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Heart24" Foreground="#FF5E7E" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="☕ Ko-fi (Buy Me a Coffee - $3)" Command="{Binding OpenKofiCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DrinkCoffee24" Foreground="#FFA500" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="🇮🇷 ری‌میت - پرداخت ریالی شتاب" Command="{Binding OpenReymitCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Money24" Foreground="#10B981" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="⭐ Star on GitHub" Command="{Binding OpenGitHubCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Star24" Foreground="#FFD700" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- TOOLBAR / CONTROLS CARD -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: Target Path Selector & Scan Button -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Enter or browse developer workspace directory (e.g. C:\repos or D:\repos)..."
                                VerticalContentAlignment="Center" Margin="0,0,8,0" />

                    <ui:Button Grid.Column="1" Command="{Binding BrowsePathCommand}"
                               Appearance="Secondary" Margin="0,0,8,0" ToolTip="Browse for workspace folder">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" />
                            <TextBlock Text="Browse..." />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Grid.Column="2" Command="{Binding ScanCommand}"
                               Appearance="Primary" Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Search24" Margin="0,0,6,0" />
                            <TextBlock Text="Scan Workspace" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <!-- Row 2: Quick Path Preset Chips & Recycle Bin Toggle -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Quick paths:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="C:\repos"
                                   Appearance="Transparent" Padding="8,2" Margin="0,0,6,0">
                            <TextBlock Text="📁 C:\repos" FontSize="11" Foreground="#38BDF8" />
                        </ui:Button>
                        <ui:Button Command="{Binding SelectQuickPathCommand}" CommandParameter="D:\repos"
                                   Appearance="Transparent" Padding="8,2" Margin="0,0,6,0">
                            <TextBlock Text="📁 D:\repos" FontSize="11" Foreground="#38BDF8" />
                        </ui:Button>
                    </StackPanel>

                    <!-- Recycle Bin Toggle (Anchored on right of Row 2) -->
                    <CheckBox Grid.Column="1" IsChecked="{Binding SendToRecycleBin}"
                              Content="Recycle Bin (Safe Undo)" VerticalAlignment="Center"
                              ToolTip="Moves files to the Windows Recycle Bin instead of permanent deletion" />
                </Grid>

                <!-- Row 3: Responsive Filters & Action Toolbar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Filter Controls (Uses WrapPanel to wrap gracefully if window is narrow) -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Filter by Age -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,10,2">
                            <TextBlock Text="Min Age:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox SelectedIndex="{Binding MinAgeFilterIndex}" Width="120">
                                <ComboBoxItem Content="All Folders" />
                                <ComboBoxItem Content="> 7 days" />
                                <ComboBoxItem Content="> 14 days" />
                                <ComboBoxItem Content="> 30 days" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Live Real-Time Search Filter -->
                        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Filter results..."
                                    Width="130" VerticalContentAlignment="Center" Margin="0,2,10,2"
                                    ClearButtonEnabled="True" />

                        <!-- Quick Selection Buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,8,2">
                            <ui:Button Command="{Binding SelectAllCommand}" Appearance="Transparent" Padding="6,4" Margin="0,0,4,0">
                                <TextBlock Text="Select All" FontSize="11" />
                            </ui:Button>
                            <ui:Button Command="{Binding DeselectAllCommand}" Appearance="Transparent" Padding="6,4">
                                <TextBlock Text="Deselect All" FontSize="11" />
                            </ui:Button>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Right: Reclaimable Summary Badge & PURGE BUTTON (Always visible & pinned to the right) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,2,0,2">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12" />
                        </Border>

                        <ui:Button Command="{Binding PurgeCommand}"
                                   Appearance="Danger" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" />
                                <TextBlock Text="Purge Selected" FontWeight="Bold" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN DATA GRID -->
        <Grid Grid.Row="2">
            <!-- Progress Bar during active scan/purge -->
            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4" />

            <DataGrid ItemsSource="{Binding DisplayedItems}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeight="38"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <DataGrid.Columns>
                    <!-- Checkbox Column -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                            Width="38" Header="" />

                    <!-- Category / Ecosystem Badge (Color Coded) -->
                    <DataGridTemplateColumn Header="Category" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CategoryBadgeBackground}"
                                        BorderBrush="{Binding CategoryBadgeBorder}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="Medium"
                                               Foreground="{Binding CategoryBadgeForeground}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Folder Name & Path -->
                    <DataGridTemplateColumn Header="Folder Path" Width="*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Age / Last Modified -->
                    <DataGridTextColumn Header="Last Modified" Binding="{Binding FormattedAge}" Width="105" />

                    <!-- Size Column -->
                    <DataGridTemplateColumn Header="Size" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold" Foreground="#38BDF8"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions (Open in Explorer) -->
                    <DataGridTemplateColumn Header="" Width="45">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Command="{Binding OpenInExplorerCommand}"
                                           Appearance="Transparent" Padding="4" ToolTip="Open folder in File Explorer">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" />
                                </ui:Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State Prompt -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasNoItemsAndNotScanning, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="FolderSearch24" FontSize="48" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="Ready to scan for disposable build artifacts"
                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Click the 'Scan Workspace' button above to locate bin/obj, node_modules, and target caches."
                           FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️ 100% Offline • Zero Telemetry • Open Source Forever"
                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,16,0" />
                <TextBlock Text="by Behrad87" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>
