<ui:FluentWindow x:Class="DevPurge.App.Views.PurgeSuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Space Reclaimed!"
        Height="490" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Icon="pack://application:,,,/Assets/icon.ico">

    <Grid Background="#D60B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DevPurge — Milestone Reached" ShowMaximize="False" Icon="pack://application:,,,/Assets/icon.png" />

        <Grid Grid.Row="1" Margin="24,8,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Celebratory Success Badge & Reclaimed Counter -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <!-- Glowing Checkmark Ring -->
                <Border Width="60" Height="60" CornerRadius="30" Background="#064E3B"
                        BorderBrush="#10B981" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="32" Foreground="#10B981"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ReclaimedSizeText" Text="93.72 GB Reclaimed!"
                           FontSize="24" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                <TextBlock x:Name="FoldersCountText" Text="Across 1,721 folders • Moved to Windows Recycle Bin"
                           FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 2. Value Anchor Card (SSD Hardware Worth) -->
            <Border Grid.Row="1" Background="#99111827" BorderBrush="#243044" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#451A03" Width="38" Height="38" CornerRadius="19"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="HardDrive24" FontSize="20" Foreground="#F59E0B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="EstimatedValueText" Text="Estimated NVMe storage value: ~$14.00"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="You just postponed a drive upgrade and uncluttered your dev workspace."
                                   FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Friendly Open-Source Pitch -->
            <TextBlock Grid.Row="2"
                       Text="DevPurge is 100% free, offline, and open-source forever (no paywalls, no tracking). If this reclaimed meaningful SSD space on your machine, consider buying the developer a coffee!"
                       TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8"
                       TextAlignment="Center" Margin="0,0,0,16" LineHeight="17" />

            <!-- 4. Support Buttons -->
            <StackPanel Grid.Row="3" Orientation="Vertical" VerticalAlignment="Center">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0" Click="OnKofiClicked" Appearance="Secondary" Margin="0,0,4,0" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DrinkCoffee24" Margin="0,0,8,0" Foreground="#FFA500" />
                            <TextBlock Text="Tip on Ko-fi ($3)" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Grid.Column="1" Click="OnReymitClicked" Appearance="Secondary" Margin="4,0,0,0" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" Margin="0,0,8,0" Foreground="#10B981" />
                            <TextBlock Text="ری‌میت (شتاب)" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <ui:Button Click="OnSponsorClicked" Appearance="Primary" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Heart24" Margin="0,0,8,0" Foreground="#FF5E7E" />
                        <TextBlock Text="Sponsor on GitHub (Wall of Fame)" FontWeight="Bold" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- 5. Close Action -->
            <ui:Button Grid.Row="4" Click="OnCloseClicked" Appearance="Transparent"
                       HorizontalAlignment="Center" Content="Close &amp; Continue Coding" Margin="0,10,0,0"
                       Foreground="#94A3B8" />
        </Grid>
    </Grid>
</ui:FluentWindow>
